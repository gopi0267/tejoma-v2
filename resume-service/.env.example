# Resume Service Configuration Example

NODE_ENV=development
LOG_LEVEL=info
PORT=4031

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tejoma_resume
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Configuration (must be set in production)
JWT_SECRET=your-jwt-secret-key-here

# Service URLs
UPLOAD_SERVICE_URL=http://localhost:4030
MONOLITH_INTERNAL_URL=http://localhost:3000

# Redis (job queue)
REDIS_URL=redis://localhost:6379

# Skill Extraction
SKILL_EXTRACTION_MODEL=simple
MIN_SKILL_CONFIDENCE=0.6

# Job Queue Configuration
JOB_QUEUE_CONCURRENCY=2
JOB_ATTEMPTS=3

# Feature Flags
UPLOAD_SERVICE_ENABLED=false
