node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example
backups/
.venv/
uploads/*
!uploads/.gitkeep

# Candidate PII / sample data - kept on disk, not version controlled
resumes/
resumedata.csv
db_store.json
*.dump

# Local tool/editor state - not shared project config
.claude/
.vscode/

# Trained ML model artifacts - generated at runtime via /train, not source
python-services/matching-ml-service/models/

# Python runtime/cache artifacts
__pycache__/
*.pyc
python-services/**/.venv/

# TLS certs (self-signed dev certs and any real certbot output) - regenerable, never committed
nginx/certs/
nginx/certbot/

# Nginx/app log volumes
logs/

# Generated migration/cutover audit artifacts (scripts/candidate-service-mismatch-report.ts and
# similar) - operational output, not source, regenerable on demand
reports/

# Terraform local state and per-environment overrides - state especially must never be committed
# (it can contain sensitive resource attributes) - see terraform/README.md's "before your first
# real apply" section on moving to a remote S3+DynamoDB backend instead.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
!terraform/terraform.tfvars.example
terraform/crash.log
# terraform/.terraform.lock.hcl is deliberately NOT ignored - it locks exact provider versions
# for reproducibility and is meant to be committed, unlike the state/cache files above it.

