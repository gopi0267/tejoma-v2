# Upload Service Configuration Example

NODE_ENV=development
LOG_LEVEL=info
PORT=4030

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tejoma_uploads
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Configuration (must be set in production)
JWT_SECRET=your-jwt-secret-key-here

# Storage Configuration (S3 or Azure)
STORAGE_TYPE=s3
S3_BUCKET=tejoma-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key

# File Limits
MAX_FILE_SIZE_BYTES=10485760

# Service URLs
RESUME_SERVICE_URL=http://localhost:4031
MONOLITH_INTERNAL_URL=http://localhost:3000

# Feature Flags
RESUME_SERVICE_ENABLED=false
