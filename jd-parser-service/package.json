{
  "name": "@tejoma/jd-parser-service",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tejoma JD Parser Service - Tier 0 (Batch 15). Extracted from src/jd-parser/ - the hybrid regex/dictionary/NLP pipeline that turns pasted job description text into structured fields. Stateless: no database, a pure function of its input plus one gracefully-degrading call to the Python NLP microservice.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "benchmark": "tsx benchmark/jd-parser-benchmark.ts",
    "benchmark:with-nlp": "tsx benchmark/jd-parser-benchmark.ts --with-nlp"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.14.0",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.25.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.10"
  }
}
