# Tejoma - environment variable reference. Copy this to .env.local for local development
# (`cp .env.example .env.local`) and fill in real values. .env.local is gitignored - never
# commit real secrets. For a Docker Compose deployment, see .env.production.example instead.

# ============================================================================
# Database (required)
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tejoma_recruiting
DB_USER=postgres
DB_PASSWORD=your-postgres-password
# Connection pool size - optional, these are the app's own defaults if unset.
DB_POOL_MIN=2
DB_POOL_MAX=10

# ============================================================================
# App runtime (required)
# ============================================================================
# development | production. Controls secure cookies, CSP, trust proxy, and static-file serving.
NODE_ENV=development
# Origin(s) the API accepts credentialed requests from. Comma-separated for multiple (e.g. an
# apex + www domain in production). Required in production (app refuses to boot without it).
FRONTEND_URL=http://localhost:3006
# trace | debug | info | warn | error | fatal - optional, defaults to debug in development and
# info in production.
LOG_LEVEL=debug

# ============================================================================
# Authentication (required in production)
# ============================================================================
# Signs JWT access tokens. Required in production - the app refuses to boot if this is left as
# the insecure dev default. Generate a real one with: openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret

# ============================================================================
# OTP delivery - email (optional; falls back to console-logging the OTP if unset, dev-friendly
# but must be configured for real signup/login flows)
# ============================================================================
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# ============================================================================
# OTP delivery - SMS (optional; falls back to console-logging the OTP if unset)
# ============================================================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567

# ============================================================================
# Candidate "Continue with Google" sign-in (optional; if any of these three are unset, the
# button still renders but redirects to a clear "not configured" error instead of crashing)
# ============================================================================
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3006/api/candidate-auth/google/callback

# ============================================================================
# Recruiter/staff "Continue with Google" sign-in (optional; reuses GOOGLE_CLIENT_ID/SECRET above,
# but needs its own redirect URI added to the same OAuth client's "Authorized redirect URIs" in
# Google Cloud Console. Only signs in an EXISTING recruiter/admin account matched by email - it
# never auto-creates a company, so an unrecognized Google email gets a clear error asking them to
# register their company or ask an admin to invite them first.)
# ============================================================================
STAFF_GOOGLE_REDIRECT_URI=http://localhost:3006/api/auth/google/callback

# ============================================================================
# AI (required for resume parsing, JD-parser NLP fallback fields, and the RAG chatbot)
# ============================================================================
GEMINI_API_KEY=your-gemini-api-key-here

# ============================================================================
# Python microservices (optional - default to localhost, correct for running all 3 processes
# manually on one machine; override for Docker Compose, see .env.production.example)
# ============================================================================
JD_NLP_SERVICE_URL=http://localhost:8008
MATCHING_ML_SERVICE_URL=http://localhost:8009
