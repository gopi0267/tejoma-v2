# Notifications Service Configuration Example

NODE_ENV=development
LOG_LEVEL=info
PORT=4032

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tejoma_notifications
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Configuration (must be set in production)
JWT_SECRET=your-jwt-secret-key-here

# Redis (job queue and pub/sub)
REDIS_URL=redis://localhost:6379

# Monolith (dual-write)
MONOLITH_INTERNAL_URL=http://localhost:3000

# Socket.io Settings
SOCKET_HEARTBEAT_INTERVAL=30000
SOCKET_CONNECTION_TIMEOUT=60000

# Optional Integrations
EMAIL_ENABLED=false
SMS_ENABLED=false
PUSH_ENABLED=false

# Frontend URL
FRONTEND_URL=http://localhost:3006
